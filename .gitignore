# User manuals & PDFs (Strictly prevent committing copyrighted content)
manuals/*
*.pdf
*.PDF

# Keep the manuals/ folder itself trackable (README only), never its contents
!manuals/README.md

# User local workspace & generated artifacts
workspace/*
!workspace/README.md
output/
reports/

