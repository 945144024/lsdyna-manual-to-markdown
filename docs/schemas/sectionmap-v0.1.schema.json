{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsdyna-manual-builder.invalid/schema/sectionmap-v0.1.json",
  "title": "LS-DYNA Manual SectionMap v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "document",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "manual_type",
        "release",
        "volume"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "manual_type": {
          "enum": [
            "keyword",
            "theory"
          ]
        },
        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "volume": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "manual_type": {
                "const": "keyword"
              }
            }
          },
          "then": {
            "properties": {
              "document_id": {
                "pattern": "^keyword-volume-[123]$"
              },
              "volume": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "manual_type": {
                "const": "theory"
              }
            }
          },
          "then": {
            "properties": {
              "document_id": {
                "const": "theory"
              },
              "volume": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "keyword_id",
          "name",
          "volume",
          "kind",
          "parent_section_id",
          "pdf_pages",
          "manual_pages",
          "document_id",
          "section_number"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "keyword_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "volume": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 3
          },
          "kind": {
            "enum": [
              "keyword",
              "document",
              "theory"
            ]
          },
          "parent_section_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "pdf_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          },
          "manual_pages": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+-[0-9]+$"
            }
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "section_number": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
